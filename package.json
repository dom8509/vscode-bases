{
  "name": "vscode-bases",
  "displayName": "Bases",
  "description": "Obsidian-Bases-style workbench for the metadata of Markdown and YAML files in your workspace.",
  "version": "0.1.0",
  "publisher": "dom8509",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dom8509/vscode-bases.git"
  },
  "homepage": "https://github.com/dom8509/vscode-bases#readme",
  "bugs": {
    "url": "https://github.com/dom8509/vscode-bases/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.base"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "bases.editor",
        "displayName": "Base",
        "selector": [
          {
            "filenamePattern": "*.base"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "bases.newBase",
        "title": "New Base",
        "category": "Bases"
      },
      {
        "command": "bases.openAsText",
        "title": "Open Base as Text",
        "category": "Bases"
      },
      {
        "command": "bases.showSource",
        "title": "Show Source",
        "category": "Bases",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bases.showPreview",
        "title": "Open Base",
        "category": "Bases",
        "icon": "$(open-preview)"
      }
    ],
    "languages": [
      {
        "id": "yaml",
        "extensions": [
          ".base"
        ]
      }
    ],
    "configuration": {
      "title": "Bases",
      "properties": {
        "bases.include": {
          "type": "string",
          "default": "**/*.{md,markdown,yml,yaml}",
          "description": "Glob of the files a base indexes."
        },
        "bases.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**"
          ],
          "description": "Globs excluded from indexing, in addition to `files.exclude`."
        },
        "bases.confirmBulkEdits": {
          "type": "boolean",
          "default": true,
          "description": "Ask before an edit that changes more than one file, with the option to see the changes as a diff first."
        },
        "bases.pageSize": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "description": "Rows per page in a base's table."
        },
        "bases.newNoteFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder that **+ New** in a base creates notes in, relative to the workspace folder. Empty: the workspace folder itself. A view that filters on `file.inFolder(…)` uses that folder instead, so the note shows in it."
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "bases.newBase",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "bases.showSource",
          "when": "activeCustomEditorId == bases.editor",
          "group": "navigation"
        },
        {
          "command": "bases.showPreview",
          "when": "resourceExtname == .base && !activeCustomEditorId",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "bases.showSource",
          "when": "activeCustomEditorId == bases.editor"
        },
        {
          "command": "bases.showPreview",
          "when": "resourceExtname == .base && !activeCustomEditorId"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bases.showSource",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "activeCustomEditorId == bases.editor"
      },
      {
        "command": "bases.showPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && resourceExtname == .base"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run check && vsce package",
    "test:integration": "node esbuild.mjs --tests && node dist/test/run.js",
    "test:perf": "node esbuild.mjs --tests && node dist/test/run.js --perf"
  },
  "dependencies": {
    "markdown-it": "^14.3.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
